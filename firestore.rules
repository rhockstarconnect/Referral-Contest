
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public competition leaderboard.
    match /leaderboard/{participantId} {
      allow read: if true;
      allow write: if false;
    }

    // Public prize information.
    match /settings/prizes {
      allow read: if true;
      allow write: if false;
    }

    // Participant records and click-deduplication records.
    match /participants/{participantId} {
      allow read, write: if false;

      match /visitors/{visitorId} {
        allow read, write: if false;
      }
    }

    // Private email lookup and administration data.
    match /private/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
