rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Starter rules: participants can read their own contest profile.
    // A trusted backend/admin SDK must create verified click/registration events
    // and apply count adjustments. Do not allow users to edit counts or roles.
    match /contestUsers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'participant'
                    && request.resource.data.clicks == 0
                    && request.resource.data.registrations == 0;
      allow update, delete: if false;
    }

    // No client-side access to tracking records or admin/audit data.
    match /referralClicks/{clickId} {
      allow read, write: if false;
    }
    match /registrationEvents/{eventId} {
      allow read, write: if false;
    }
    match /adminAudit/{auditId} {
      allow read, write: if false;
    }

    // Existing collections are deliberately not modified by this starter.
    // Review your existing rules before deploying any rules to the live project.
  }
}
